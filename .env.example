APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Chave de cifra dos dados sensíveis: 32 bytes em base64.
# Gere a sua com a instrução da seção 6.2 do README e nunca versione.
APP_KEY=
APP_KEY_VERSION=1
# Chaves anteriores, usadas apenas para decifrar o que já foi gravado: 1:base64:...,2:base64:...
APP_KEY_PREVIOUS=
# Chave do índice cego (CPF). Separada da APP_KEY para sobreviver à rotação.
APP_INDEX_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Integrações externas — preencher somente quando implementadas
PAYMENT_PROVIDER=
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
